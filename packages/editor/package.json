{
  "name": "@sbuild/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "pnpm --filter @sbuild/shared build >/dev/null && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "pnpm --filter @sbuild/shared build >/dev/null && tsc -p tsconfig.test.json >/dev/null && node --test src/**/*.test.js"
  },
  "dependencies": {
    "@sbuild/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.19"
  }
}
