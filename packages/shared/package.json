{
  "name": "@sbuild/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "bash ../../scripts/generate-build-meta.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bash ../../scripts/generate-build-meta.sh >/dev/null && tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json >/dev/null && node --test 'src/**/*.test.ts'"
  }
}
